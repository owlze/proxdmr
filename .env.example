# ProxDMR - Configuration Template
# Copy this file to .env and adjust as needed

# Host IP or domain name for SSL certificate generation
HOST_IP=127.0.0.1

# Web interface port (HTTPS / WSS)
PORT=8266

# BrandMeister Homebrew UDP port
DMR_PORT=62031

# Enable HTTPS/WSS with self-signed certificate (recommended: true)
USE_SSL=true

# Initial administrator credentials (created on first run)
ADMIN_USER=admin
ADMIN_PASSWORD=proxdmr123

# Allow open registration for new users (false recommended for public/white IP)
ALLOW_REGISTRATION=false

# Server label for Telegram alerts (optional, defaults to hostname)
# SERVER_LABEL=MyServer

# Demo mode configuration (listen-only guest access without changing settings)
# DEMO_MODE=false
# DEMO_MAX_SESSIONS=10
# DEMO_SESSION_MINUTES=10
# DEMO_COOLDOWN_SECONDS=60
